{
  "manifest_version": 3,
  "name": "鹊桥翻译",
  "description": "在 arXiv 等论文页面一键用鹊桥 Queqiao 打开中文译文。",
  "version": "0.1.0",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "用鹊桥翻译这篇论文",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "contextMenus"],
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://arxiv.org/abs/*", "https://www.arxiv.org/abs/*", "https://arxiv.org/html/*"],
      "js": ["paper.js", "content.js"],
      "css": ["content.css"]
    }
  ]
}
